# Copy to .env and fill in. Never commit .env.
# LLM: any OpenAI-compatible API. Default: Groq free tier (console.groq.com).
# Mistral: LLM_BASE_URL=https://api.mistral.ai/v1  LLM_MODEL=mistral-small-latest
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Leave QDRANT_URL empty to use local storage in QDRANT_PATH; set it for docker compose or Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
TOP_K=5
MIN_SCORE=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=30
